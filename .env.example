# Copie para .env e ajuste os valores. Todas as variáveis são obrigatórias,
# exceto PORT (padrão 3000). A API não sobe se alguma estiver faltando.

PORT=3000
GEMINI_API_KEY=

# Origem permitida no CORS (URL do front)
CORS_ORIGIN=http://localhost:5173

# Biblioteca (conteúdos publicados) e pasta de entrada (conteúdos gerados
# aguardando decisão: adicionar à biblioteca ou descartar)
LIB_DIR=D:/homelab/lib
TEMP_DOCS_DIR=D:/homelab/temp/docs

# Temporários dos pipelines de vídeo
TEMP_VIDEO_DIR=D:/homelab/temp/video
TEMP_AUDIO_DIR=D:/homelab/temp/audio

# Whisper (transcrição local)
WHISPER_DIR=D:/homelab/ai/whisper
WHISPER_EXECUTABLE=whisper-cli.exe
WHISPER_MODEL=ggml-large-v3-turbo.bin

# Ollama (IA local)
OLLAMA_URL=http://localhost:11434
